# Copy this file to .env and fill in real values. Never commit .env.
# Spring Boot reads these via spring-dotenv at startup.

# PostgreSQL password for the user configured in application.properties
SPRING_DATASOURCE_PASSWORD=changeme

# JWT signing secret. UTF-8 string, MUST be at least 32 characters for HS256.
# Generate a random one in a shell:
#   openssl rand -base64 48
APP_JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Optional overrides (uncomment in production)
# APP_DB_DDL_AUTO=validate
# APP_CORS_ALLOWED_ORIGINS=https://micultura.com,https://www.micultura.com
# APP_SECURITY_COOKIE_SECURE=true
# APP_SECURITY_COOKIE_SAME_SITE=None
# APP_SEED_ENABLED=false
